parameters:
	level: max
	paths:
		- ../../etc
		- ../../src
		- ../../tests
		- ../dev-app
	ignoreErrors:
		-
			identifier: wyrihaximus.reactphp.eventLoop.propertyLoopInterface
			path: ../../tests/Stub/UsesControlledEventLoop.php
		-
			identifier: wyrihaximus.reactphp.eventLoop.passLoopInterface
			path: ../../tests/Stub/UsesControlledEventLoop.php
	ergebnis:
		noExtends:
			classesAllowedToBeExtended:
				- Composer\IO\NullIO
				- ShipMonk\PHPStan\DeadCode\Provider\ReflectionBasedMemberUsageProvider
includes:
    - ../../extension.neon
